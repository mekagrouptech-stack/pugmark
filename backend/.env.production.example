# Production - Copy to .env and set NODE_ENV=production
NODE_ENV=production
PORT=6000

# Production database — set DB_USER and DB_PASSWORD from your cPanel MySQL user
# Override if your hosting uses different values
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mekacom_pugmark
DB_USER=mekacom_pugmarkuser
DB_PASSWORD=your-production-db-password

# JWT - CHANGE IN PRODUCTION
JWT_SECRET=your-production-secret-key
JWT_EXPIRES_IN=24h

# CORS - Frontend URL(s) allowed to access API
# Single origin:
CORS_ORIGIN=https://hrm.meka.com
# Multiple origins (comma-separated):
# CORS_ORIGINS=https://hrm.meka.com,https://www.hrm.meka.com

# Biometric device (eSSL AIFace Orcus) — /iclock source IP allowlist.
# Set this to the public IP the terminal connects FROM (your office/site IP).
# Comma-separated for multiple sites. Leave empty to accept any IP (not
# recommended when the server has a public address).
ICLOCK_ALLOWED_IPS=
