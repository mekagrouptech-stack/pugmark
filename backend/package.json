{
  "name": "hrms-attendance-backend",
  "version": "1.0.0",
  "description": "Location-based attendance system backend",
  "main": "index.js",
  "scripts": {
    "start": "NODE_ENV=production node index.js",
    "dev": "nodemon index.js",
    "start:prod": "NODE_ENV=production node index.js",
    "start:all": "cd .. && npm run start:all",
    "test": "jest",
    "db:create": "node scripts/create-database.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:fix-leaves": "node scripts/fix-leaves-now.js",
    "db:diagnose-leaves": "node scripts/diagnose-leave-approval.js",
    "db:fix-leave-status": "node scripts/fix-leave-status.js",
    "db:create-leave-approvals": "node scripts/create-leave-approvals-table.js",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "db:reset": "sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate && sequelize-cli db:seed:all",
    "db:setup": "node scripts/setup-complete-database.js",
    "db:sync-pins": "node scripts/sync-device-pins.js",
    "db:sync-pins:dry": "node scripts/sync-device-pins.js --dry-run",
    "db:sync-attendance": "node scripts/sync-device-pins.js --backfill-only",
    "db:backfill-attendance": "node scripts/backfill-attendance.js",
    "db:backfill-attendance:dry": "node scripts/backfill-attendance.js --dry-run",
    "create:admin": "node scripts/create-admin-user.js",
    "create:new-admin": "node scripts/create-new-admin.js",
    "create:all-users": "node scripts/create-all-user-types.js",
    "create:multiple-users": "node scripts/create-multiple-users.js"
  },
  "keywords": [
    "attendance",
    "location",
    "geofencing",
    "hrms"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "moment-timezone": "^0.5.47",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "mysql2": "^3.6.5",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.10.1",
    "sequelize": "^6.35.2",
    "socket.io": "^4.8.3",
    "sqlite3": "^5.1.7",
    "winston": "^3.11.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "sequelize-cli": "^6.6.2"
  }
}
