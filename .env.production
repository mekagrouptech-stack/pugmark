# Production build environment — used automatically by `vite build`.
# Overrides .env (which stays on localhost for local `npm run dev`).
#
# The Node app is mounted at pugmarkhr.com/api (cPanel Application URL) AND the
# app itself mounts routes under /api, so the real REST base is /api/api.
# Static/storage is served at the app root, i.e. pugmarkhr.com/api/storage.
VITE_API_BASE_URL=https://pugmarkhr.com/api/api
VITE_STORAGE_BASE_URL=https://pugmarkhr.com/api
